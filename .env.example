# Environment variable manifest.
#
# Copy to .env.local and fill in real values. Never commit .env.local.
#
# This file exists because dev/prod env drift is the single largest source
# of production incidents in this project (see LESSONS_LEARNED.md): vars
# that existed locally but were never added to the deployed environment.
# When you add a variable anywhere, add it here too.
#
# Reminder from LESSONS_LEARNED.md: after adding a var in a hosting
# dashboard, redeploy with "Use existing Build Cache" UNCHECKED — a plain
# redeploy does not always re-inject env vars.

# ---------------------------------------------------------------
# Supabase — needed by: Next.js app, tests, trigger.dev job
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# THE MASTER KEY — bypasses Row-Level Security completely.
# Used only by the daily background job (lib/supabase/service.ts) and by
# the isolation tests. Never expose to the browser, never prefix with
# NEXT_PUBLIC_. Supabase dashboard -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------
# Hevy — needed by: Next.js app, trigger.dev job
# ---------------------------------------------------------------
# Process-wide, not per-user. This is why the daily job serves one account.
HEVY_API_KEY=

# ---------------------------------------------------------------
# Gmail — needed by: Next.js app, trigger.dev job
# ---------------------------------------------------------------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Scope: gmail.readonly. Reads the LoseIt daily CSV. Cannot send.
GMAIL_REFRESH_TOKEN=

# Scope: gmail.send. Sends the trainer email. Cannot read.
# Must be a SEPARATE token from the one above — OAuth scopes are fixed when
# the token is granted, so the read-only token cannot be upgraded to send.
GMAIL_SEND_REFRESH_TOKEN=

# ---------------------------------------------------------------
# Azure OpenAI — needed by: Next.js app, trigger.dev job
# ---------------------------------------------------------------
# Endpoint must be the Foundry deployment's Target URI stripped to
# https://<resource>.cognitiveservices.azure.com/ — if it contains
# "/models" it is wrong for the OpenAI SDK (LESSONS_LEARNED.md).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# ---------------------------------------------------------------
# Daily job — needed by: trigger.dev job only
# ---------------------------------------------------------------
# The single Supabase auth user the daily job runs for. The job refuses to
# start without it rather than guessing or looping over everyone.
# Supabase dashboard -> Authentication -> Users -> the UID column.
ONLY_ALLOWED_USER_ID=

# Optional. When set, the daily job sends the trainer email HERE instead of
# to the trainer — for checking a run without mailing them. Leave unset in
# production. Server-side only; never read by the browser.
TRAINER_EMAIL_OVERRIDE=

# trigger.dev project ref (dashboard -> Project settings). Not a secret.
# trigger.config.ts falls back to a placeholder if unset.
TRIGGER_PROJECT_REF=

# For triggering tasks from app code. Not needed by the CLI, which uses
# `npx trigger.dev login`. Prefixes: tr_dev_ / tr_prod_.
TRIGGER_SECRET_KEY=
