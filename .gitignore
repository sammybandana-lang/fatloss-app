# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the manifest, which holds names and comments only, never values.
# LESSONS_LEARNED.md calls env drift the biggest source of prod incidents
# here, and a manifest that can't be committed can't help with that.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Google OAuth client secrets — never commit
client_secret*.json
*oauth-client.json